GEMINI_API_KEY=

# Option B: leave GEMINI_API_KEY empty and run Ollama locally (https://ollama.com)
# ollama pull llama3.2:3b
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2:3b
# LLM_BASE_URL=http://localhost:11434/v1

# PostgreSQL
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ragdb

# --- GraphRAG (free Neo4j Community Edition) ---
# Set USE_GRAPH_RAG=true to enable knowledge-graph-augmented retrieval.
# Neo4j runs as a Docker service (see docker-compose.yml).
USE_GRAPH_RAG=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=securepassword
